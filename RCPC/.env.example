# RCPC Agent Configuration Example
# Copy this file to .env and adjust variables as required

# Network & Server
RCPC_HOST=0.0.0.0
RCPC_PORT=8765
RCPC_DEBUG=false
RCPC_ALLOWED_ORIGINS=*

# Security & Pairing
# Master secret for signing tokens (auto-generated if empty)
RCPC_JWT_SECRET=
# Session expiration in seconds (default: 30 days = 2592000)
RCPC_TOKEN_EXPIRY_SECONDS=2592000
# Rate limit: max requests per minute per IP
RCPC_RATE_LIMIT_PER_MINUTE=120

# Sandboxed File Directories (semicolon separated absolute or relative paths)
# Defaults to: Desktop/RCPC Shared; Downloads; Documents; Uploads
RCPC_ALLOWED_FILE_DIRS=

# Application Allowlist (display name to executable path or command)
# e.g. "Chrome=chrome.exe;VS Code=code;Terminal=wt.exe;Notepad=notepad.exe;Spotify=spotify.exe"
RCPC_ALLOWED_APPS=

# Telemetry
RCPC_TELEMETRY_INTERVAL_MS=1000

# High-Risk Safety
# Require confirmation token for HIGH risk commands (shutdown, restart, etc.)
RCPC_REQUIRE_HIGH_RISK_CONFIRMATION=true
